# ===== Supabase (open-source database + auth) =====
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# ===== Stripe (payments) =====
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` locally, or the dashboard webhook endpoint

# ===== Resend (registration / receipt emails) =====
# Free tier at https://resend.com. Alternatively swap lib/email.ts to Nodemailer + any SMTP.
RESEND_API_KEY=re_...
EMAIL_FROM="KIDA Welfare <welfare@yourdomain.org>"

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Officials who may open the /registry admin view (comma-separated emails).
# They sign in through the member portal with these addresses.
OFFICIALS_EMAILS=records@kidawelfare.org,treasurer@kidawelfare.org
